{
  "name": "react-navigation-prune",
  "version": "0.1.0",
  "description": "Zero-dependency, version-agnostic helpers to remove intermediate screens from a React Navigation stack (v5, v6, v7) in a single state update.",
  "license": "MIT",
  "author": "ersincakmak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ersincakmak/react-navigation-prune.git"
  },
  "homepage": "https://github.com/ersincakmak/react-navigation-prune#readme",
  "bugs": {
    "url": "https://github.com/ersincakmak/react-navigation-prune/issues"
  },
  "sideEffects": false,
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "react-native": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./lib/module/index.js",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rm -rf lib",
    "build": "pnpm clean && tsc -p tsconfig.build.json --module commonjs --outDir lib/commonjs && tsc -p tsconfig.build.json --module es2020 --outDir lib/module && tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir lib/typescript && node -e \"require('fs').writeFileSync('lib/commonjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}');require('fs').writeFileSync('lib/module/package.json','{\\\"type\\\":\\\"module\\\"}')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/types/tsconfig.json",
    "test": "pnpm build && node --test test/*.test.js test/integration/*.test.js",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "keywords": [
    "react-native",
    "react-navigation",
    "navigation",
    "stack",
    "reset",
    "remove",
    "prune",
    "flow",
    "wizard"
  ],
  "peerDependencies": {
    "react": ">=16.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "core-v5": "npm:@react-navigation/core@^5.16.1",
    "core-v6": "npm:@react-navigation/core@^6.4.17",
    "core-v7": "npm:@react-navigation/core@^7.25.0",
    "react": "^18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.0",
  "publishConfig": {
    "access": "public"
  }
}
