{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "react-navigation-prune": [
        "../../src/index.ts"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-native": [
        "./node_modules/react-native/types_generated/index.d.ts"
      ],
      "@react-navigation/*": [
        "./node_modules/@react-navigation/*"
      ]
    }
  },
  "include": [
    "App.tsx",
    "index.ts",
    "../shared",
    "../../src"
  ]
}
